# ============================================================
# 开发工具箱 —— 环境变量样例
# 用法：cp .env.example .env 然后按需修改。真实 .env 不要提交到仓库。
# ============================================================

# ---------- 基础 ----------
APP_NAME=开发工具箱
ENV=prod
DEBUG=false
HOST=0.0.0.0
PORT=8000
# 反向代理在网关（nginx）后面时填对外路径前缀，例如 /toolbox
ROOT_PATH=

# ---------- 安全 / 认证 ----------
# 必填！生产环境不填会直接启动失败。生成方式：openssl rand -hex 32
SECRET_KEY=please-change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# 门户用 HTTPS 访问时设为 true（否则浏览器会丢弃 Secure Cookie）
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# 多子域共享登录态时才需要，例如 .example.com
# COOKIE_DOMAIN=

# 首次启动时创建的管理员。密码留空则随机生成并打印到启动日志一次。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
ALLOW_BOOTSTRAP_ADMIN=true

# ---------- 数据库 ----------
# 留空则使用 <项目根>/data/devtoolbox.db
DATABASE_URL=
DB_PATH=
SQL_ECHO=false

# ---------- CORS ----------
# 仅前后端分离开发时需要，生产同源部署留空。多个用逗号分隔。
CORS_ORIGINS=

# ---------- 反向代理 ----------
PROXY_ENABLED=true
PROXY_TIMEOUT_SECONDS=60
PROXY_CONNECT_TIMEOUT_SECONDS=10
PROXY_MAX_REDIRECTS=5
# 内网自签证书场景保持 false；也可在单张卡片上单独设置
PROXY_VERIFY_TLS=false
# 跳板机场景通常必须为 true，否则无法代理到 10./172./192.168. 地址
PROXY_ALLOW_PRIVATE_TARGETS=true
# 可选白名单，非空时只允许代理到这些主机（支持 *.example.com）。多个用逗号分隔。
PROXY_ALLOWED_HOSTS=
# 是否重写 HTML/CSS 中的根路径资源，让内网页面样式脚本能正常加载
PROXY_REWRITE_HTML=true
# 剥离上游 X-Frame-Options / CSP，便于 iframe 或跨端嵌入
PROXY_STRIP_SECURITY_HEADERS=true
# 给上游 Cookie 加 slug 前缀。多个内网系统共用同名 Cookie（如 JSESSIONID）时开启，
# 但会破坏通过 document.cookie 读取登录态的站点，默认关闭。
PROXY_COOKIE_NAMESPACE=false
# 内网转发通常应关闭，避免流量被机器上的 HTTP_PROXY 环境变量劫持
PROXY_TRUST_ENV=false
# 单个请求体上限（字节），默认 64MB
PROXY_MAX_BODY_BYTES=67108864

# ---------- 卡片图标上传 ----------
UPLOADS_ENABLED=true
# 单个图标上限（字节），默认 512KB
UPLOAD_MAX_ICON_BYTES=524288
# 上传根目录，留空则用 <项目根>/data/uploads
# 注意：systemd 部署时该目录必须在 ReadWritePaths 白名单内
UPLOADS_DIR=

# ---------- 卡片配置导入 ----------
# 导入文件上限（字节），默认 5MB。xlsx/csv 是整批配置，比图标大得多。
UPLOAD_MAX_IMPORT_BYTES=5242880

# ---------- 日志 ----------
LOG_LEVEL=INFO
# true=结构化 JSON（便于采集到 ELK/Loki）；本地排查可设 false 更易读
LOG_JSON=true
